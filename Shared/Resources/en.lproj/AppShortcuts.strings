/*
  AppShortcuts.strings
  Siri phrases, keyed by the English literal in StartRecordingIntent.swift.
  Note the ${applicationName} spelling: the Swift side writes \(.applicationName),
  and a mismatch here fails silently.
*/

"Record voice with ${applicationName}" = "Record voice with ${applicationName}";
"Transcribe with ${applicationName}" = "Transcribe with ${applicationName}";
