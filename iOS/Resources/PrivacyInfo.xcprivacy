<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Corvin collects nothing. Speech is transcribed on device by whisper.cpp,
	     history stays in a local Core Data store, and the only network traffic is
	     127.0.0.1 (app <-> keyboard extension) plus model downloads from Hugging Face. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: settings readable only by the app itself. -->
				<string>CA92.1</string>
				<!-- 1C8F.1: settings shared with the keyboard extension through
				     the group.com.corvinvoice.app App Group. -->
				<string>1C8F.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: FileLogger calls attributesOfItem(atPath:) to size the
				     shared corvin.log inside the App Group container before trimming it. -->
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
